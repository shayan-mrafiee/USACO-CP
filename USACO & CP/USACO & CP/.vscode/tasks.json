{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile C++ file",
            "type": "shell",
            "command": ": > \"${workspaceFolder}/output.txt\" && : > \"${workspaceFolder}/errors.txt\" && g++-16 -std=gnu++17 -g -O0 -Wall \"${file}\" -o \"${workspaceFolder}/run\" -Wl,-stack_size,0x10000000",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}